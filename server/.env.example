HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/interview-studio
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: configure a Judge0 CE instance/service to run coding submissions.
# The URL is required for execution. For self-hosted instances, set JUDGE0_API_KEY if enabled.
# For RapidAPI, set JUDGE0_API_KEY, JUDGE0_API_KEY_HEADER=X-RapidAPI-Key, and JUDGE0_RAPIDAPI_HOST.
# JUDGE0_API_URL=https://your-judge0-host
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=

# Set these only when creating the initial administrator with `npm run seed:admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
